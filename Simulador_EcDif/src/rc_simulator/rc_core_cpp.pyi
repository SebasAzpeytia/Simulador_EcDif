"""Type stubs para el módulo nativo C++20 rc_core_cpp exportado con pybind11."""

from numpy.typing import NDArray
import numpy as np

class CircuitParams:
    R: float
    C: float
    E0: float
    omega: float
    q0: float
    t_sim: float
    num_points: int

    def __init__(
        self,
        R: float = 50.0,
        C: float = 0.01,
        E0: float = 200.0,
        omega: float = 2.0,
        q0: float = 0.0,
        t_sim: float = 3.0,
        num_points: int = 2500,
    ) -> None: ...

class CircuitMetrics:
    @property
    def tau(self) -> float: ...
    @property
    def ts_4tau(self) -> float: ...
    @property
    def ts_5tau(self) -> float: ...
    @property
    def Xc(self) -> float: ...
    @property
    def Z(self) -> float: ...
    @property
    def phi_rad(self) -> float: ...
    @property
    def phi_deg(self) -> float: ...
    @property
    def I_max(self) -> float: ...
    @property
    def Vc_max(self) -> float: ...
    @property
    def i_0(self) -> float: ...
    @property
    def K_q(self) -> float: ...
    @property
    def K_i(self) -> float: ...
    @property
    def max_err_q(self) -> float: ...
    @property
    def max_err_i(self) -> float: ...
    @property
    def rmse_q(self) -> float: ...
    @property
    def rmse_i(self) -> float: ...

    def __init__(self) -> None: ...

class SimulationResult:
    @property
    def metrics(self) -> CircuitMetrics: ...
    @property
    def t(self) -> NDArray[np.float64]: ...
    @property
    def E_source(self) -> NDArray[np.float64]: ...
    @property
    def q_exact(self) -> NDArray[np.float64]: ...
    @property
    def q_trans(self) -> NDArray[np.float64]: ...
    @property
    def q_ss(self) -> NDArray[np.float64]: ...
    @property
    def Vc_exact(self) -> NDArray[np.float64]: ...
    @property
    def VR_exact(self) -> NDArray[np.float64]: ...
    @property
    def i_exact(self) -> NDArray[np.float64]: ...
    @property
    def i_trans(self) -> NDArray[np.float64]: ...
    @property
    def i_ss(self) -> NDArray[np.float64]: ...
    @property
    def q_rk4(self) -> NDArray[np.float64]: ...
    @property
    def Vc_rk4(self) -> NDArray[np.float64]: ...
    @property
    def i_rk4(self) -> NDArray[np.float64]: ...

class RCSolver:
    @staticmethod
    def compute_metrics(params: CircuitParams) -> CircuitMetrics: ...
    @staticmethod
    def simulate(params: CircuitParams) -> SimulationResult: ...

